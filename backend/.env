# Обычные настройки бэкенда без Docker. Секретов здесь нет, поэтому файл лежит в репозитории.
# Пароли и ключи (JWT_SECRET, DATABASE_URL) — в secrets.env в корне репозитория.
# Если вынесли secrets.env из проекта, укажите путь к нему:
# SECRETS_FILE=C:\secrets\famigo\secrets.env

APP_ENV=development
PORT=8080

# Адреса фронтенда через запятую (CORS). 5173 — vite dev-сервер.
ALLOWED_ORIGINS=http://localhost:5173

# Время жизни токенов
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=720h

# Кука входа: Secure только по HTTPS; SameSite strict | lax | none (none требует Secure)
COOKIE_SECURE=false
COOKIE_SAMESITE=strict

# Адреса прокси, которым можно верить в X-Forwarded-For (через запятую). Пусто — никому.
TRUSTED_PROXIES=

# Попыток входа и регистрации в минуту с одного IP
AUTH_RATE_LIMIT=20
# Всех запросов в минуту с одного IP
RATE_LIMIT=600

UPLOAD_DIR=uploads
DEMO_PAYMENTS=true

# Нейросеть для подбора блюд: любой OpenAI-совместимый API. Пусто AI_BASE_URL — подбор выключен.
# Сейчас — локальная Ollama на этом компьютере. Облачный провайдер: его адрес и модель здесь,
# а ключ AI_API_KEY — в secrets.env (с ключом адрес должен быть https://).
AI_BASE_URL=http://localhost:11434/v1
AI_MODEL=gemma4:e4b
# none — без «размышлений»: у Gemma и Qwen в Ollama ответ в несколько раз быстрее
AI_REASONING=none
# schema — ответ строго по JSON-схеме; object — для провайдеров без схем (например, DeepSeek)
AI_JSON_MODE=schema
# Сколько ждать ответа: локальная модель на процессоре думает 1–3 минуты
AI_TIMEOUT=5m
# Сколько запросов к модели одновременно (локальная считает по одному)
AI_MAX_CONCURRENT=1
