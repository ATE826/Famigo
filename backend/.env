# Обычные настройки бэкенда без Docker. Секретов здесь нет, поэтому файл лежит в репозитории.
# Пароли и ключи (JWT_SECRET, DATABASE_URL) — в secrets.env в корне репозитория.
# Если вынесли secrets.env из проекта, укажите путь к нему:
# SECRETS_FILE=C:\secrets\famigo\secrets.env

APP_ENV=development
PORT=8080

# Адреса фронтенда через запятую (CORS). 5173 — vite dev-сервер.
ALLOWED_ORIGINS=http://localhost:5173

# Время жизни токенов
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=720h

# Кука входа: Secure только по HTTPS; SameSite strict | lax | none (none требует Secure)
COOKIE_SECURE=false
COOKIE_SAMESITE=strict

# Адреса прокси, которым можно верить в X-Forwarded-For (через запятую). Пусто — никому.
TRUSTED_PROXIES=

# Попыток входа и регистрации в минуту с одного IP
AUTH_RATE_LIMIT=20
# Всех запросов в минуту с одного IP
RATE_LIMIT=600

UPLOAD_DIR=uploads
DEMO_PAYMENTS=true
