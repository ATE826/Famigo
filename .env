# Обычные настройки для docker compose. Секретов здесь нет, поэтому файл лежит в репозитории.
# Пароли и ключи — в отдельном файле secrets.env (образец: secrets.env.example),
# который в репозиторий не попадает и который можно хранить вне папки проекта.

# development — для разработки; production — строгий режим
# (обязателен JWT_SECRET, кука только по HTTPS, нет демо-оплаты).
APP_ENV=development

# Адрес, по которому открывают сайт.
PUBLIC_URL=http://localhost:8080

# true, когда сайт работает по HTTPS.
COOKIE_SECURE=false

# Оформление подписки без оплаты (только для разработки и защиты проекта).
DEMO_PAYMENTS=true

# Нейросеть для подбора блюд. Ollama запускается отдельным сервисом Compose,
# а ollama-init автоматически загружает AI_MODEL при первом запуске параллельно с сайтом.
# Пусто AI_BASE_URL — подбор блюд выключен. Ключ облачного провайдера (AI_API_KEY) — в secrets.env.
AI_BASE_URL=http://ollama:11434/v1
AI_MODEL=gemma4:e4b
AI_REASONING=none
AI_TIMEOUT=5m
