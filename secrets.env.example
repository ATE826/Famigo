# ШАБЛОН: скопируйте в secrets.env и замените ВСЕ значения в угловых скобках.
# Для отдельной установки используйте собственные пароль БД и ключи.
# Заполненный secrets.env не добавляйте в Git и не публикуйте.

# Пароль новой локальной БД. В существующей БД пароль меняется отдельно.
# Одинарные кавычки защищают символ $ от подстановки Docker Compose.
POSTGRES_PASSWORD='<свой пароль БД>'

# В обоих URL тот же пароль, но с URL-кодированием специальных символов.
# Примеры: @ -> %40, # -> %23, $ -> %24, % -> %25.
# Подключение с компьютера к Docker-базе:
DATABASE_URL='postgres://famigo:<URL-кодированный пароль БД>@localhost:15432/famigo?sslmode=disable'
# Подключение backend внутри Docker:
DOCKER_DATABASE_URL='postgres://famigo:<URL-кодированный пароль БД>@db:5432/famigo?sslmode=disable'

# Собственный случайный секрет минимум 32 символа.
JWT_SECRET='<свой случайный JWT-секрет>'
# Другой случайный ключ: ровно 32 байта в Base64; префикс 1: сохраните.
MESSAGE_KEYS='1:<свой ключ шифрования в Base64>'

# Пароль приложения Gmail, а не обычный пароль входа в аккаунт.
# Он должен соответствовать SMTP_USERNAME / EMAIL_FROM в .env.
# Для Go без Docker отправитель задаётся в backend/.env.
SMTP_PASSWORD='<пароль приложения тестового Gmail без пробелов>'

# Необязательные ключи — только при использовании соответствующих провайдеров:
# RESEND_API_KEY='<ключ Resend, если EMAIL_PROVIDER=resend>'
# AI_API_KEY='<ключ внешнего AI-провайдера, если нужен>'
